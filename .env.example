# Ruta al JSON del Service Account de Firebase (solo extracción de datos, no dashboard)
# Generar en: Firebase Console → Configuración → Cuentas de servicio → Nueva clave privada
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json

# ID del proyecto Firebase (sin credenciales, solo referencia)
FIREBASE_PROJECT_ID=hackandslash-aabf7

# Clave API de Google Gemini (Asistente IA y resumen ejecutivo del dashboard)
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Claves de respaldo opcionales para rotación si una agota su cuota
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
