# Credenciales — NUNCA subir al repo
.env
credentials/
credentials/*.json
.claude/jira_credentials.json
.claude/settings.json

# Datos brutos — NUNCA subir (JSON masivos de Firestore)
data/raw/

# Datos procesados — JSON brutos no, parquets sí (necesarios para Streamlit Cloud)
data/processed/*.json
data/processed/*.csv
!data/processed/*.parquet

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Reports generados (se regeneran con el notebook 08)
reports/*.html
reports/*.pdf

# Scripts de parche temporales
_fix_*.py
_patch_*.py
_regen_*.py
_rebuild_*.py
